```sql 
    WITH Monthly_Revenue AS
(
    SELECT
        YEAR(order_date) AS Sales_Year,
        MONTH(order_date) AS Sales_Month,
        DATE_FORMAT(order_date, '%Y-%m') AS Year_Months,

        ROUND(SUM(sales), 2) AS Total_Revenue

    FROM sales

    GROUP BY
        YEAR(order_date),
        MONTH(order_date),
        DATE_FORMAT(order_date, '%Y-%m')
),

Previous_Month_Revenue AS
(
    SELECT
        Sales_Year,
        Sales_Month,
        Year_Months,
        Total_Revenue,

        LAG(Total_Revenue) OVER(
            ORDER BY Sales_Year, Sales_Month
        ) AS Previous_Month_Revenue

    FROM Monthly_Revenue
)

SELECT
    Year_Months,
    Total_Revenue,
    Previous_Month_Revenue,

    ROUND(
        Total_Revenue - Previous_Month_Revenue,
        2
    ) AS Revenue_Difference,

    ROUND(
        (Total_Revenue - Previous_Month_Revenue)
        * 100.0 / NULLIF(Previous_Month_Revenue, 0),
        2
    ) AS Growth_Percentage,

    CASE
        WHEN Previous_Month_Revenue IS NULL THEN 'No Previous Data'
        WHEN Total_Revenue > Previous_Month_Revenue THEN 'Growth'
        WHEN Total_Revenue < Previous_Month_Revenue THEN 'Decline'
        ELSE 'No Change'
    END AS Revenue_Status,

    RANK() OVER(
        ORDER BY Total_Revenue DESC
    ) AS Revenue_Rank

FROM Previous_Month_Revenue

ORDER BY Sales_Year, Sales_Month;
```
