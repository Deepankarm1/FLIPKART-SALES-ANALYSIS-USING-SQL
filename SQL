```sql
create database Flipkart_Analytics;
```
```sql
use Flipkart_Analytics;
```

```sql
SELECT
    COUNT(*) AS Total_Transactions,
    COUNT(DISTINCT order_id) AS Total_Orders,
    COUNT(DISTINCT customer_id) AS Total_Customers,
    ROUND(SUM(sales), 2) AS Total_Revenue,
    ROUND(SUM(sales) / COUNT(DISTINCT order_id), 2) AS Average_Order_Value,
    SUM(quantity) AS Total_Quantity_Sold,
    ROUND(AVG(sales), 2) AS Average_Transaction_Value,
    MAX(sales) AS Highest_Transaction,
    MIN(sales) AS Lowest_Transaction,

    COUNT(DISTINCT CASE
        WHEN shipping_status = 'Cancelled' THEN order_id
    END) AS Cancelled_Orders,

    ROUND(
        COUNT(DISTINCT CASE
            WHEN shipping_status = 'Cancelled' THEN order_id
        END) * 100.0 / COUNT(DISTINCT order_id),
        2
    ) AS Cancellation_Rate

FROM sales;
```

```sql
SELECT
    category,
    sub_category,
    COUNT(DISTINCT order_id) AS Total_Orders,
    SUM(quantity) AS Total_Quantity,
    ROUND(SUM(sales), 2) AS Total_Revenue,
    ROUND(AVG(sales), 2) AS Average_Sales

FROM sales

GROUP BY
    category,
    sub_category

HAVING SUM(sales) > 50000

ORDER BY
    Total_Revenue DESC;
```


```sql    
WITH Payment_Analysis AS
(
    SELECT
        payment_method,
        COUNT(DISTINCT order_id) AS Total_Orders,
        ROUND(SUM(sales), 2) AS Total_Revenue,
        ROUND(AVG(sales), 2) AS Average_Transaction_Value

    FROM sales

    GROUP BY payment_method
)

SELECT
    payment_method,
    Total_Orders,
    Total_Revenue,
    Average_Transaction_Value,

    ROUND(
        Total_Revenue * 100.0 /
        SUM(Total_Revenue) OVER(),
        2
    ) AS Revenue_Contribution_Percentage,

    RANK() OVER(
        ORDER BY Total_Revenue DESC
    ) AS Revenue_Rank

FROM Payment_Analysis

ORDER BY Total_Revenue DESC;
```

```sql
SELECT
    c.customer_id,
    c.education,
    c.income,
    c.loyalty_score,

    CASE
        WHEN c.income < 50000 THEN 'Low Income'
        WHEN c.income <= 80000 THEN 'Medium Income'
        ELSE 'High Income'
    END AS Income_Group,

    COUNT(DISTINCT s.order_id) AS Total_Orders,
    COUNT(s.transaction_id) AS Total_Transactions,
    ROUND(SUM(s.sales), 2) AS Total_Revenue

FROM customers c

INNER JOIN sales s
    ON c.customer_id = s.customer_id

GROUP BY
    c.customer_id,
    c.education,
    c.income,
    c.loyalty_score

ORDER BY Total_Revenue DESC

LIMIT 10;
```


```sql
SELECT
    p.supplier,

    GROUP_CONCAT(
        DISTINCT s.category
        ORDER BY s.category
    ) AS Product_Categories,

    COUNT(DISTINCT s.order_id) AS Total_Orders,
    SUM(s.quantity) AS Total_Quantity_Sold,
    ROUND(SUM(s.sales), 2) AS Total_Revenue,
    ROUND(AVG(p.rating), 2) AS Average_Product_Rating,

    CASE
        WHEN SUM(s.sales) > 250000 THEN 'High Revenue'
        WHEN SUM(s.sales) >= 200000 THEN 'Medium Revenue'
        ELSE 'Low Revenue'
    END AS Supplier_Performance

FROM products p

INNER JOIN sales s
    ON p.product_id = s.product_id

GROUP BY p.supplier

HAVING SUM(s.sales) > 200000

ORDER BY Total_Revenue DESC;
```


```sql
WITH Customer_Spending AS
(
    SELECT
        c.customer_id,
        c.education,
        c.income,
        COUNT(DISTINCT s.order_id) AS Total_Orders,
        ROUND(SUM(s.sales), 2) AS Total_Purchase_Value

    FROM customers c

    INNER JOIN sales s
        ON c.customer_id = s.customer_id

    GROUP BY
        c.customer_id,
        c.education,
        c.income
),

Customer_Segments AS
(
    SELECT
        customer_id,
        education,
        income,
        Total_Orders,
        Total_Purchase_Value,

        CASE
            WHEN Total_Purchase_Value > 5000 THEN 'Premium'
            WHEN Total_Purchase_Value >= 2500 THEN 'Regular'
            ELSE 'Occasional'
        END AS Customer_Segment

    FROM Customer_Spending
)

SELECT
    Customer_Segment,
    COUNT(customer_id) AS Total_Customers,
    SUM(Total_Orders) AS Total_Orders,
    ROUND(SUM(Total_Purchase_Value), 2) AS Total_Revenue,
    ROUND(AVG(Total_Purchase_Value), 2) AS Average_Customer_Spending

FROM Customer_Segments

GROUP BY Customer_Segment

ORDER BY Total_Revenue DESC;
```


```sql
SELECT
    transaction_id,
    order_id,
    customer_id,
    product_id,
    category,
    sales

FROM sales

WHERE sales >
(
    SELECT AVG(sales)
    FROM sales
)

ORDER BY sales DESC;


SELECT
    COUNT(*) AS Total_Transactions,
    ROUND(SUM(sales), 2) AS Total_Revenue,
    ROUND(AVG(sales), 2) AS Average_Sales

FROM sales

WHERE sales >
(
    SELECT AVG(sales)
    FROM sales
);

SELECT
    category,
    COUNT(*) AS Total_Transactions,
    ROUND(SUM(sales), 2) AS Total_Revenue

FROM sales

WHERE sales >
(
    SELECT AVG(sales)
    FROM sales
)

GROUP BY category

ORDER BY Total_Revenue DESC

LIMIT 1;
```


```sql
WITH Customer_Spending AS
(
    SELECT
        c.customer_id,
        c.income,
        c.loyalty_score,
        ROUND(SUM(s.sales), 2) AS Total_Spending

    FROM customers c

    INNER JOIN sales s
        ON c.customer_id = s.customer_id

    GROUP BY
        c.customer_id,
        c.income,
        c.loyalty_score
)

SELECT
    customer_id,
    income,
    loyalty_score,
    Total_Spending

FROM Customer_Spending

WHERE Total_Spending >
(
    SELECT AVG(Total_Spending)
    FROM Customer_Spending
)

ORDER BY Total_Spending DESC;
```


```sql
WITH Category_Revenue AS
(
    SELECT
        category,
        ROUND(SUM(sales), 2) AS Total_Revenue

    FROM sales

    GROUP BY category
)

SELECT
    category,
    Total_Revenue,

    RANK() OVER(
        ORDER BY Total_Revenue DESC
    ) AS Revenue_Rank,

    DENSE_RANK() OVER(
        ORDER BY Total_Revenue DESC
    ) AS Dense_Revenue_Rank,

    ROW_NUMBER() OVER(
        ORDER BY Total_Revenue DESC
    ) AS Row_Numbers

FROM Category_Revenue

ORDER BY Total_Revenue DESC;
```

```sql
WITH Customer_Category_Revenue AS
(
    SELECT
        s.category,
        c.customer_id,
        c.education,

        ROUND(SUM(s.sales), 2) AS Total_Revenue

    FROM sales s

    INNER JOIN customers c
        ON s.customer_id = c.customer_id

    GROUP BY
        s.category,
        c.customer_id,
        c.education
),

Customer_Ranking AS
(
    SELECT
        category,
        customer_id,
        education,
        Total_Revenue,

        ROW_NUMBER() OVER(
            PARTITION BY category
            ORDER BY Total_Revenue DESC
        ) AS Customer_Rank

    FROM Customer_Category_Revenue
)

SELECT
    category,
    customer_id,
    education,
    Total_Revenue,
    Customer_Rank

FROM Customer_Ranking

WHERE Customer_Rank <= 3

ORDER BY
    category,
    Customer_Rank;
```    
    
